# Copy to .env.local and fill in. Never commit secrets.

# --- Supabase (client) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# --- Supabase (server only — never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# --- Anthropic (call scoring) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- ElevenLabs (voice agent) ---
ELEVENLABS_API_KEY=xi-xxx
ELEVENLABS_AGENT_ID=agent_xxx
VITE_ELEVENLABS_AGENT_ID=agent_xxx
ELEVENLABS_AGENT_PHONE_NUMBER_ID=phnum_xxx
# ElevenLabs post-call webhook (required for live calls — no client polling)
# Create in ElevenLabs → Agents → your agent → Webhooks
# URL: https://YOUR-PROJECT-REF.supabase.co/functions/v1/elevenlabs-webhook
# Enable: post_call_transcription (+ call_initiation_failure)
ELEVENLABS_WEBHOOK_SECRET=wsec_xxx

# --- Mailgun (server only — used by Supabase Edge Functions) ---
MAILGUN_API_KEY=key-xxxxxxxxx
MAILGUN_DOMAIN=mail.ghostshopper.ai
MAILGUN_FROM_EMAIL="GhostShopper <noreply@mail.ghostshopper.ai>"
# EU accounts: https://api.eu.mailgun.net
MAILGUN_API_BASE=https://api.mailgun.net
APP_URL=http://localhost:5175
# Supabase Auth → Send Email hook signing secret (Edge Function only).
# Dashboard: Authentication → Hooks → Send Email. Include the v1,whsec_ prefix.
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxx
